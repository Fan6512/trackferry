# Published image: packs the binaries that scripts/publish.sh built for each platform.
FROM scratch
ARG TARGETARCH
COPY dist/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY dist/${TARGETARCH}/trackferry /trackferry
# The shared volume takes this directory's owner.
COPY --chown=10001:10001 build/run /run/trackferry
USER 10001:10001
ENV TRACKFERRY_CONFIG=/data/config.yaml TZ=Asia/Shanghai
EXPOSE 18561
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["/trackferry", "healthcheck"]
ENTRYPOINT ["/trackferry"]
CMD ["serve"]
