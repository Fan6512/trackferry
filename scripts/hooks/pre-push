#!/usr/bin/env bash
# Last gate before anything leaves this machine: messages, tests, and the release rules for tags.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
remote="${1:-origin}"
tested=
while read -r _ sha ref old; do
  case "$ref" in
    refs/tags/v*)
      tag="${ref#refs/tags/}"
      [ "$sha" != "$zero" ] || { echo "✗ 不能删除已发布的标签 $tag" >&2; exit 1; }
      [ "$old" = "$zero" ] || { echo "✗ 不能移动已发布的标签 $tag" >&2; exit 1; }
      [ "$(git cat-file -t "$sha")" = tag ] || { echo "✗ $tag 要用带说明的标签：git tag -a" >&2; exit 1; }
      [ "$(git rev-parse "$sha^{commit}")" = "$(git rev-parse HEAD)" ] || { echo "✗ 请先切到 $tag 所在的提交" >&2; exit 1; }
      scripts/check-release.sh "$tag"
      ;;
    refs/heads/main)
      [ "$sha" != "$zero" ] || { echo "✗ 不能删除 main" >&2; exit 1; }
      if [ "$old" != "$zero" ] && ! git merge-base --is-ancestor "$old" "$sha"; then echo "✗ main 不能强制推送" >&2; exit 1; fi
      ;;
  esac
  [ "$sha" != "$zero" ] || continue
  if [ "$old" != "$zero" ] && git cat-file -e "$old" 2>/dev/null; then
    node scripts/check-commits.mjs "$old..$sha"
  else
    node scripts/check-commits.mjs "$sha" --not --remotes="$remote"
  fi
  if [ -z "$tested" ]; then
    tested=1
    echo "测试中…"
    go vet ./... && go test ./... >/dev/null || { echo "✗ Go 测试没有通过：go test ./..." >&2; exit 1; }
    (cd web && npm run --silent typecheck && npm test --silent >/dev/null) || { echo "✗ 管理页检查没有通过：cd web && npm test" >&2; exit 1; }
  fi
done
