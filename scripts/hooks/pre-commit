#!/usr/bin/env bash
# Keeps private data out, and what is committed tidy.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
bad=0
fail() { echo "✗ $*" >&2; bad=1; }

while IFS= read -r -d '' f; do
  case "$f" in
    .env.example) ;;
    .private/* | data/* | */data/private/* | .env | .env.* | *.private.json | *.sqlite* | *.db) fail "$f 是私有数据，不能提交" ;;
  esac
  size="$(git cat-file -s ":$f")"
  [ "$size" -le 3145728 ] || fail "$f 超过 3 MB"
  case "$f" in scripts/hooks/pre-commit) continue ;; esac
  if git show ":$f" | grep -aEq 'BEGIN [A-Z ]*PRIVATE KEY|(passToken|serviceToken|music-token)["'"'"']?[=:] *["'"'"']?[A-Za-z0-9+/_%-]{40,}'; then fail "$f 里像是有密钥或登录凭据"; fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

git diff --cached --check >/dev/null || fail "有行尾空格或冲突标记：git diff --cached --check"
go_files="$(git diff --cached --name-only --diff-filter=ACMR -- '*.go')"
if [ -n "$go_files" ]; then
  untidy="$(printf '%s\n' "$go_files" | xargs gofmt -l)"
  [ -z "$untidy" ] || fail "没有 gofmt：$untidy"
fi
scripts/check-release.sh >/dev/null || fail "版本号不一致"
exit $bad
